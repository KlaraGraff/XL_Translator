{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translator",
  "version": "9.2.6",
  "identifier": "com.klara-graff.translator",
  "build": {
    "beforeDevCommand": "cd ui && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "cd ui && npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Translator",
        "width": 1380,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "dmg",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/sidecar": "sidecar"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMEEyQzRFRjQ1RUM0RTgKUldUb3hGNzBUaXdLYmpyeVA2QkJGNDRNbndRYmhSUndnUEhRb2JxaTZxYkY5NXg5TFI4QlN4RTMK",
      "endpoints": [
        "https://github.com/KlaraGraff/XL_Translator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
